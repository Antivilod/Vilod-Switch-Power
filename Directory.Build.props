<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><EnableWindowsTargeting>true</EnableWindowsTargeting><Deterministic>true</Deterministic><PathMap>$(MSBuildThisFileDirectory)=/_/vsp/</PathMap><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols><ContinuousIntegrationBuild>true</ContinuousIntegrationBuild></PropertyGroup></Project>